# Copy to .env.product. Keep real keys in that ignored local file.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AGENT_MODEL=deepseek-flash
AGENT_THINKING_LEVEL=high
TREK_PORT=3000
TZ=Asia/Shanghai
DEFAULT_LANGUAGE=zh

# AMap Web Service key: https://lbs.amap.com/api/mcp-server/create-project-and-key
AMAP_API_KEY=
SOURCES_ROUTES_PROVIDER=amap
# Optional alternative for walking/driving; does not provide transit.
GEOAPIFY_API_KEY=

# Optional railway service: enable with --profile railway and uncomment the URL.
RAILWAY_MCP_URL=
# RAILWAY_MCP_URL=http://railway:8000/mcp

WEB_SEARCH_PROVIDERS=exa
EXA_MCP_URL=https://mcp.exa.ai/mcp
